{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user preferences, TOTP 2FA metadata, and home currency settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homeCurrency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "totpEnabled": { "type": "boolean" },
        "totpSecret": { "type": "string", "minLength": 0, "maxLength": 128 },
        "dailyBudgetJpy": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "homeCurrency", "totpEnabled", "dailyBudgetJpy", "updatedAt"]
    },
    "VaultItem": {
      "title": "VaultItem",
      "description": "Client-side AES-256-GCM encrypted travel document envelope.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "docType": { "type": "string", "enum": ["passport", "jrpass", "hotel", "insurance", "visa", "other"] },
        "cipherTextB64": { "type": "string", "minLength": 8, "maxLength": 16000 },
        "ivB64": { "type": "string", "minLength": 8, "maxLength": 64 },
        "saltB64": { "type": "string", "minLength": 8, "maxLength": 64 },
        "alg": { "type": "string", "enum": ["AES-GCM-256"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "label", "docType", "cipherTextB64", "ivB64", "saltB64", "alg", "createdAt", "updatedAt"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "User travel expense entry in JPY.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amountJpy": { "type": "number" },
        "category": { "type": "string", "enum": ["food", "transit", "lodging", "sightseeing", "shopping"] },
        "city": { "type": "string", "minLength": 1, "maxLength": 40 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "title", "amountJpy", "category", "city", "date", "createdAt", "updatedAt"]
    },
    "TripItinerary": {
      "title": "TripItinerary",
      "description": "Saved personalized Japan trip itinerary.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "daysCount": { "type": "integer" },
        "regions": { "type": "array" },
        "planJson": { "type": "string", "minLength": 2, "maxLength": 50000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "title", "daysCount", "regions", "planJson", "createdAt", "updatedAt"]
    },
    "LearningProgress": {
      "title": "LearningProgress",
      "description": "Japanese study XP, mastered items, and streak progress.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "masteredIds": { "type": "array" },
        "xp": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "completedLessons": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "masteredIds", "xp", "streakDays", "completedLessons", "updatedAt"]
    },
    "TravelReminder": {
      "title": "TravelReminder",
      "description": "Flight or Shinkansen alert schedule.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "enum": ["shinkansen", "flight", "ferry", "hotel"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "route": { "type": "string", "minLength": 1, "maxLength": 100 },
        "departureIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "platformOrGate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "kind", "code", "route", "departureIso", "platformOrGate", "createdAt", "updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Nearby traveler social board post without PII.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 50 },
        "city": { "type": "string", "enum": ["Tokyo", "Kyoto", "Osaka", "Sapporo", "Nara", "Kanazawa"] },
        "category": { "type": "string", "enum": ["meetup", "tip", "crowd", "food"] },
        "message": { "type": "string", "minLength": 3, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "city", "category", "message", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User-submitted customer care issue report or support ticket.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ticketRef": { "type": "string", "minLength": 4, "maxLength": 20 },
        "category": { "type": "string", "enum": ["bug", "translation", "maps", "budget", "account", "content", "other"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "area": { "type": "string", "enum": ["explore", "learn", "itinerary", "budget", "safety", "published"] },
        "subject": { "type": "string", "minLength": 3, "maxLength": 100 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "contactEmail": { "type": "string", "minLength": 0, "maxLength": 160 },
        "cityContext": { "type": "string", "minLength": 1, "maxLength": 40 },
        "diagnostics": { "type": "string", "minLength": 0, "maxLength": 400 },
        "status": { "type": "string", "enum": ["open", "in_review", "resolved"] },
        "resolutionNote": { "type": "string", "minLength": 0, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "ticketRef",
        "category",
        "severity",
        "area",
        "subject",
        "description",
        "contactEmail",
        "cityContext",
        "diagnostics",
        "status",
        "resolutionNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "StampEntry": {
      "title": "StampEntry",
      "description": "Goshuin shrine seal or train station Eki stamp collector record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stampKind": { "type": "string", "enum": ["goshuin", "eki"] },
        "placeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "city": { "type": "string", "minLength": 1, "maxLength": 40 },
        "stampedDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "stampKind", "placeName", "city", "stampedDate", "notes", "createdAt", "updatedAt"]
    },
    "PackingChecklistState": {
      "title": "PackingChecklistState",
      "description": "User packing checklist completion and custom items.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checkedIds": { "type": "array" },
        "customItemsJson": { "type": "string", "minLength": 0, "maxLength": 4000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "checkedIds", "customItemsJson", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user settings and TOTP 2FA configuration."
    },
    "/users/{userId}/vaultItems/{itemId}": {
      "schema": { "$ref": "#/entities/VaultItem" },
      "description": "AES-256-GCM encrypted travel documents owned by the user."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "User travel expenses in JPY."
    },
    "/users/{userId}/itineraries/{itineraryId}": {
      "schema": { "$ref": "#/entities/TripItinerary" },
      "description": "Saved AI trip itineraries."
    },
    "/users/{userId}/learning/{progressId}": {
      "schema": { "$ref": "#/entities/LearningProgress" },
      "description": "User Japanese learning studio progress."
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/TravelReminder" },
      "description": "User flight and Shinkansen departure alerts."
    },
    "/users/{userId}/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer care tickets and reported app or travel issues owned by the user."
    },
    "/users/{userId}/stamps/{stampId}": {
      "schema": { "$ref": "#/entities/StampEntry" },
      "description": "Goshuin temple/shrine seals and Eki station stamps logged by the user."
    },
    "/users/{userId}/checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/PackingChecklistState" },
      "description": "User dynamic pre-departure packing checklist state."
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Publicly readable (signed-in) nearby traveler social board posts."
    }
  }
}
